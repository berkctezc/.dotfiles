# https://ghostty.org/docs/config/reference

theme = Dracula
font-family = "FiraCode Nerd Font Mono"
font-size = 11.5
window-padding-color = background
background-opacity = 0.7
background-blur-radius = 20
font-thicken = true
font-thicken-strength=1
adjust-cell-height = 1
cursor-color = yellow
cursor-opacity = 0.8
cursor-style = bar
cursor-style-blink = false
cursor-click-to-move = true
mouse-hide-while-typing = true
unfocused-split-opacity = 0.6
fullscreen = false
x11-instance-name = ghost tty
working-directory = home
window-vsync = true
window-theme = system
window-decoration = true
window-save-state = default
clipboard-read = ask
clipboard-write = ask
clipboard-trim-trailing-spaces = true
shell-integration = detect
macos-window-shadow = false
macos-icon = retro
macos-icon-frame = beige 
# aluminum, beige, plastic, chrome
macos-icon-ghost-color = #BBBBBB
macos-icon-screen-color = #0F6004
linux-cgroup = always
gtk-single-instance = false
window-padding-x = 5
window-padding-y = 5
confirm-close-surface = false
auto-update = download
auto-update-channel = tip
palette-harmonious = true
shell-integration-features = sudo,ssh-env,ssh-terminfo
window-subtitle = working-directory

keybind = cmd+shift+space=toggle_quick_terminal